<?xml version="1.0" encoding="utf-8"?>
<!-- 圆表专用布局：466×466 圆屏。所有元素都落在内切圆安全区内。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_dark"
    android:keepScreenOn="true">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="30dp"
        android:text="@string/app_name"
        android:textColor="#99FFFFFF"
        android:textSize="10sp" />

    <FrameLayout
        android:id="@+id/qrCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_qr_card"
        android:padding="6dp">

        <ImageView
            android:id="@+id/qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/qr_desc" />

        <LinearLayout
            android:id="@+id/mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#E6101216"
            android:visibility="gone">

            <TextView
                android:id="@+id/maskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/maskHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部：剩余有效时间。放在圆形下沿安全区内，紧贴二维码下方 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/statusDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</FrameLayout>




