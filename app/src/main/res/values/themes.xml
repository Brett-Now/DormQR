<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主题：全部 NoActionBar，标题栏由页面自己画，便于精确处理 Insets -->
    <style name="Theme.DormQr" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/surface_page</item>
        <item name="android:statusBarColor">@color/surface_page</item>
        <item name="android:navigationBarColor">@color/surface_page</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- 二维码全屏页：深色、无标题、无状态栏，二维码占满安全区 -->
    <style name="Theme.DormQr.Fullscreen" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page_dark</item>
        <item name="android:statusBarColor">@color/page_dark</item>
        <item name="android:navigationBarColor">@color/page_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- 基类：让 TextAppearance.DormQr.* 的点号继承成立 -->
    <style name="TextAppearance.DormQr" parent="@android:style/TextAppearance" />

    <!-- 页面标题文字 -->
    <style name="TextAppearance.DormQr.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.DormQr.Section">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.DormQr.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.DormQr.Aux">
        <item name="android:textSize">@dimen/text_aux</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.DormQr.Field" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingLeft">@dimen/sp_3</item>
        <item name="android:paddingRight">@dimen/sp_3</item>
        <item name="android:paddingTop">@dimen/sp_3</item>
        <item name="android:paddingBottom">@dimen/sp_3</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <style name="Widget.DormQr.Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.DormQr.Button.Tonal" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>

